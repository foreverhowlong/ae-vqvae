{
  "module": "training.run_segmental_vqvae_experiment",
  "experiments": [
    {
      "ablation": "segmental-bpe-k8192-r1p67-ar",
      "seed": 42,
      "epochs": 10,
      "batch-size": 32,
      "num-workers": 0,
      "save-every": 1000,
      "save-last-resume": false,
      "max-seq-len": 256,
      "continuous-truncation": false,
      "d-model": 448,
      "latent-dim": 32,
      "n-heads": 8,
      "encoder-layers": 4,
      "decoder-layers": 6,
      "latent-routing": "global_cross_attention",
      "segmentation-mode": "bernoulli",
      "ffn-mult": 4,
      "codebook-size": 8192,
      "commitment-beta": 0.25,
      "compression-target": 1.67,
      "compression-weight": 10.0,
      "gate-logit-l2-weight": 0.0001,
      "gate-threshold": 0.5,
      "decoder-boundary-loss-weight": 1.0,
      "decoder-boundary-threshold": 0.5,
      "ema-decay": 0.99,
      "ae-warmup-min-steps": 1000,
      "ae-warmup-max-steps": 6000,
      "ae-warmup-check-every": 200,
      "ae-warmup-patience": 5,
      "ae-warmup-dim-tolerance": 1,
      "intervention-probe-examples": 32,
      "free-running-every": 2000,
      "free-running-samples": 32
    }
  ]
}
